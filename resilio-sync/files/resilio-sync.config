config resilio-sync 'main'
	option enabled '0'
	option user 'rslsync'
	option device_name 'OpenWrt'
	option storage_mount '/mnt/storage'
	option storage_uuid ''
	option state_dir '/mnt/storage/.resilio-sync'
	option directory_root '/mnt/storage/data/Resilio'
	option webui_address '127.0.0.1'
	option webui_port '8888'
	option webui_login 'admin'
	option listening_port '55555'
	option use_upnp '0'
	option download_limit '0'
	option upload_limit '0'
