#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
START=95
STOP=10
USE_PROCD=1

start_service() {
	. /usr/lib/resilio-sync/common.sh
	resilio_load
	[ "$enabled" = 1 ] || return 0
	/usr/libexec/resilio-sync-config prepare || {
		logger -t resilio-sync 'Startup deferred: check disk, paths and credentials'
		return 1
	}
	/usr/bin/rslsync --help >/dev/null 2>&1 || {
		logger -t resilio-sync 'Runtime unavailable; run resilio-sync-runtime install'
		return 1
	}
	procd_open_instance main
	procd_set_param command /usr/bin/rslsync --nodaemon --config /var/run/resilio-sync/config.json --log "$state_dir/sync.log"
	procd_set_param user "$user"
	procd_set_param group "$(id -gn "$user")"
	# Resilio derives its initial default folder from HOME. procd otherwise
	# leaves it at '/', producing an unwritable '//Resilio Sync' location.
	procd_set_param env HOME="$directory_root" USER="$user" LOGNAME="$user"
	procd_set_param nice 10
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/resilio-sync /etc/resilio-sync/webui-password.hash
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger resilio-sync
}
