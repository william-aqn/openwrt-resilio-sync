#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
. /usr/lib/resilio-sync/runtime.conf
base="/usr/lib/resilio-sync/vendor/$RUNTIME_ID"
if [ ! -x "$base/rslsync" ] || [ ! -x "$COMPAT_LIB_DIR/ld-linux-aarch64.so.1" ] || [ ! -e "$COMPAT_LIB_DIR/libcrypt.so.1" ]; then
	echo 'Runtime missing. Run: resilio-sync-runtime install' >&2
	exit 1
fi
unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
export LC_ALL=C.UTF-8
export GCONV_PATH="$COMPAT_LIB_DIR/gconv"
export LOCPATH="$COMPAT_LIB_DIR/locale"
exec "$COMPAT_LIB_DIR/ld-linux-aarch64.so.1" --argv0 rslsync --inhibit-cache \
	--library-path "$COMPAT_LIB_DIR" "$base/rslsync" "$@"
