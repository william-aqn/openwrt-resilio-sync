#!/bin/sh
# SPDX-License-Identifier: MIT
# Replace only the Web UI password; never recreate identity or TLS material.
set -eu
export LC_ALL=C
umask 077
[ "$(id -u)" = 0 ] || exit 1
[ "${1:-}" = --password-stdin ] && [ "$#" = 1 ] || {
	echo 'Usage: resilio-sync-password --password-stdin' >&2
	exit 2
}
IFS= read -r password || exit 2
carriage_return=$(printf '\r')
password=${password%"$carriage_return"}
case "$password" in *[![:print:]]*) exit 2 ;; esac
[ "${#password}" -ge 12 ] && [ "${#password}" -le 128 ] || exit 2

credentials=/etc/resilio-sync
hash="$credentials/webui-password.hash"
service=/etc/init.d/resilio-sync
lock=/var/lock/resilio-sync-password.lock
[ -d "$credentials" ] && [ ! -L "$credentials" ] || exit 3
for file in "$hash" "$credentials/server.crt" "$credentials/server.key"; do
	[ -s "$file" ] && [ -f "$file" ] && [ ! -L "$file" ] || exit 3
done
exec 9>"$lock"
flock -n 9 || exit 4

work=$(mktemp -d "$credentials/.password.XXXXXX") || exit 5
trap 'rm -f "$work/new" "$work/previous"; rmdir "$work"' EXIT
trap 'exit 5' HUP INT TERM
cp -p "$hash" "$work/previous" || exit 5
printf '%s\n' "$password" | openssl passwd -6 -stdin > "$work/new" || exit 5
unset password
# shellcheck disable=SC2016 # Match the literal SHA-512 crypt prefix and fields.
grep -Eq '^\$6\$[./A-Za-z0-9]+\$[./A-Za-z0-9]{86}$' "$work/new" || exit 5
chmod 600 "$work/new"
mv "$work/new" "$hash" || exit 5

# A disabled/stopped service stays stopped. Reload regenerates the runtime
# config and lets procd restart an existing process without a blocking stop.
if "$service" running >/dev/null 2>&1; then
	if ! "$service" reload >/dev/null 2>&1; then
		mv "$work/previous" "$hash" || exit 7
		"$service" reload >/dev/null 2>&1 || true
		exit 6
	fi
	exit 0
fi
exit 10
